{
  "manifest_version": 2,
  "name": "M365 OWA Sync (Contacts + Calendar)",
  "author": "luk27094",
  "description": "Sync Microsoft 365 calendar and contacts with Thunderbird via Outlook on the web (OWA) service endpoints. Log in to OWA once through the addon; tokens are captured from your own OWA session and refreshed automatically. No Azure app registration required.",
  "version": "1.2.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "m365-owa@luk27094.local",
      "strict_min_version": "156.0",
      "strict_max_version": "156.*"
    }
  },

  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "64": "icon.svg",
    "96": "icon.svg"
  },

  "permissions": [
    "storage",
    "addressBooks",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "alarms",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://*.office.com/*",
    "https://*.office365.com/*",
    "https://*.cloud.microsoft/*"
  ],

  "calendar_provider": {
    "capabilities": {
      "timezones": { "floating": false, "UTC": true },
      "attachments": false,
      "priority": false,
      "privacy": ["default", "public", "private"],
      "categories": { "count": 3 },
      "alarms": { "count": 5, "actions": ["display", "email"] },
      "tasks": false,
      "events": true,
      "remove_modes": ["unsubscribe", "delete"],
      "requires_network": true,
      "minimum_refresh_interval": 30,
      "scheduling": "server"
    }
  },

  "background": {
    "page": "background.html"
  },

  "options_ui": {
    "page": "options_ui/settings.html",
    "open_in_tab": true
  },

  "experiment_apis": {
    "calendar_calendars": {
      "schema": "experiments/calendar/schema/calendar-calendars.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiments/calendar/parent/ext-calendar-calendars.js",
        "paths": [["calendar", "calendars"]]
      }
    },
    "calendar_items": {
      "schema": "experiments/calendar/schema/calendar-items.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiments/calendar/parent/ext-calendar-items.js",
        "paths": [["calendar", "items"]]
      }
    },
    "calendar_provider": {
      "schema": "experiments/calendar/schema/calendar-provider.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiments/calendar/parent/ext-calendar-provider.js",
        "events": ["startup"],
        "paths": [["calendar", "provider"]]
      }
    }
  }
}
